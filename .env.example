# 环境变量配置文件
# ⚠️ 重要：此文件包含敏感信息，请勿提交到 Git 仓库

# TuShare API Token
# 获取方式：访问 https://tushare.pro/register 注册并获取 Token
TUSHARE_TOKEN=your_tushare_token_here

# 可选：设置缓存和输出目录
CACHE_DIR=data/cache
OUTPUT_DIR=output
MODEL_DIR=models

# 可选：TuShare API配置
TUSHARE_API_URL=http://api.tushare.pro
TUSHARE_RETRY=3
TUSHARE_BACKOFF=0.5
