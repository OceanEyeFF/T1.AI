[Unit]
Description=A-share Lab Daily Recommendation Pipeline
After=network.target

[Service]
Type=oneshot
User=oceaneye
# ⚠️ 按部署机修改路径（本仓库在两台机器间迁移，路径可能不同）
WorkingDirectory=/mnt/e/repos/WSL/personal/T1.AI
Environment="TUSHARE_TOKEN=your_token_here"
ExecStart=/mnt/e/repos/WSL/personal/T1.AI/scripts/daily_pipeline.sh
StandardOutput=append:/mnt/e/repos/WSL/personal/T1.AI/workspace/runs/pipeline.log
StandardError=append:/mnt/e/repos/WSL/personal/T1.AI/workspace/runs/pipeline.log

[Install]
WantedBy=multi-user.target
